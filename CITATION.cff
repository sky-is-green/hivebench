    alias: "sky-is-green"
version: "0.1.0"
date-released: "2026-09-22"
repository-code: "https://github.com/sky-is-green/hivebench"
url: "https://github.com/sky-is-green/hivebench"
keywords:
  - evaluation
  - benchmark
  - context-management
  - llm
  - reproducibility
